<style>
  :root {
    --bg: #faf8f4; --surface: #ffffff; --text: #1f1d1a; --muted: #6b665e;
    --border: #e6e1d8; --accent: #6a3fa0; --accent-soft: #f1ebf8;
    --amber: #f4b300; --amethyst: #80387b; --emerald: #298a34;
    --ruby: #d3082f; --sapphire: #0189c4; --steel: #8e98a3;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #15131a; --surface: #1e1b24; --text: #ece8f1; --muted: #a29cab;
      --border: #332e3b; --accent: #c3a3ec; --accent-soft: #2a2236;
    }
  }
  :root[data-theme="dark"] {
    --bg: #15131a; --surface: #1e1b24; --text: #ece8f1; --muted: #a29cab;
    --border: #332e3b; --accent: #c3a3ec; --accent-soft: #2a2236;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  main { max-width: 760px; margin: 0 auto; padding: 32px 16px 64px; }
  a { color: var(--accent); }
  h1 { font-size: 1.9rem; line-height: 1.25; margin: 0.2em 0 0.3em; }
  h2 { font-size: 1.2rem; margin: 2.2em 0 0.6em; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
  h3 { font-size: 1rem; margin: 0 0 4px; }
  .kicker { color: var(--muted); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .muted { color: var(--muted); font-size: 0.9rem; }
  ul.bullets { padding-left: 1.2em; }
  ul.bullets li { margin: 0.45em 0; }
  sup a { text-decoration: none; font-size: 0.75em; padding: 0 1px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; margin: 10px 0; }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); }
  th { color: var(--muted); font-weight: 600; font-size: 0.85rem; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .inks { display: inline-flex; gap: 3px; vertical-align: middle; }
  .ink { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .ink-Amber { background: var(--amber); } .ink-Amethyst { background: var(--amethyst); }
  .ink-Emerald { background: var(--emerald); } .ink-Ruby { background: var(--ruby); }
  .ink-Sapphire { background: var(--sapphire); } .ink-Steel { background: var(--steel); }
  ol.podium { margin: 6px 0 0; padding-left: 1.4em; }
  ol.sources { font-size: 0.9rem; padding-left: 1.8em; }
  ol.sources li { margin: 3px 0; word-break: break-word; }
  .tag { font-size: 0.75rem; background: var(--accent-soft); color: var(--accent); border-radius: 4px; padding: 1px 6px; margin-right: 4px; }
  .notice { background: var(--accent-soft); border-radius: 8px; padding: 10px 14px; font-size: 0.9rem; }
  .table-wrap { overflow-x: auto; }
  footer { margin-top: 48px; color: var(--muted); font-size: 0.85rem; }

  /* Citation popover and the source it jumps to */
  a.cite[aria-expanded="true"] { background: var(--accent-soft); border-radius: 3px; }
  .cite-pop {
    position: absolute; z-index: 10; width: min(340px, calc(100vw - 16px));
    background: var(--surface); color: var(--text); border: 1px solid var(--border);
    border-radius: 10px; padding: 12px 14px; font-size: 0.9rem; line-height: 1.45;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .cite-pop[hidden] { display: none; }
  .cite-pop-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 6px; font-size: 0.8rem; }
  .cite-pop-head .muted { font-size: 0.8rem; }
  .cite-pop-title { display: block; font-weight: 600; text-decoration: none; }
  .cite-pop-title:hover { text-decoration: underline; }
  .cite-pop-ext { font-weight: 400; }
  .cite-pop-preview { margin: 6px 0 0; color: var(--muted); }
  .cite-pop-jump { display: inline-block; margin-top: 8px; font-size: 0.85rem; }
  ol.sources li { scroll-margin-top: 30vh; border-radius: 6px; padding: 2px 6px; margin-left: -6px; }
  ol.sources li:target { background: var(--accent-soft); outline: 2px solid var(--accent); animation: src-flash 1.6s ease-out; }
  @keyframes src-flash { from { outline-offset: 6px; } to { outline-offset: 0; } }
  @media (prefers-reduced-motion: reduce) { ol.sources li:target { animation: none; } }
  ol.sources a.back { margin-left: 8px; font-size: 0.85rem; white-space: nowrap; }
</style>
